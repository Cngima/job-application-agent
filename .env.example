# Copy to .env and fill in. .env is gitignored.
# Only needed when ai.provider = anthropic_api
ANTHROPIC_API_KEY=
# Digest is only ever sent to this address
OWNER_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Token for the local FastAPI trigger used by n8n
JOBAGENT_API_TOKEN=
# Reddit Data API "script" app (only if the Reddit source is enabled)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
